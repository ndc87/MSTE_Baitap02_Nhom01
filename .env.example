# ===== MongoDB Configuration =====
MONGODB_URI=mongodb://localhost:27017/uteshop_db

# ===== JWT Secrets (REQUIRED - min 32 characters each) =====
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_required_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_required

# ===== Server Configuration =====
PORT=5000
NODE_ENV=development

# ===== Email Configuration (Gmail SMTP) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ===== OTP Configuration =====
OTP_EXPIRE_MINUTES=5

# ===== Cloudinary Configuration (for image uploads) =====
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ===== Google OAuth Configuration =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== Frontend URL (for CORS) =====
FRONTEND_URL=http://localhost:5173

# ===== Logging Level =====
LOG_LEVEL=debug
